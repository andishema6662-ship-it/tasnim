ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/admin" ADMIN_AREA=1
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=ADMIN_AREA
  Header set Pragma "no-cache" env=ADMIN_AREA
  Header set Expires "0" env=ADMIN_AREA
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy public site prefix
  RewriteRule ^site/?$ / [R=301,L]
  RewriteRule ^site/(.*)$ /$1 [R=301,L]

  # Legacy admin module URLs (pre-/admin prefix)
  RewriteRule ^(editorial|reporters|media|audience|reports|structure|template|infra)/(.*)$ /admin/$1/$2 [R=301,L]

</IfModule>
